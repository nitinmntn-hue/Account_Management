generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

model Company {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  gstNumber   String?
  logo        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  sessions     Session[]
  accounts     Account[]
  parties      Party[]
  transactions Transaction[]
}

model User {
  id            String    @id @default(uuid())

  name          String
  email         String    @unique
  mobile        String    @unique
  password      String

  role          UserRole  @default(STAFF)

  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)

  profileImage  String?

  companyId     String
  company        Company   @relation(fields: [companyId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id            String   @id @default(uuid())

  name          String
  startDate     DateTime
  endDate       DateTime

  isActive      Boolean @default(false)

  companyId     String
  company        Company @relation(fields: [companyId], references: [id])

  transactions  Transaction[]

  createdAt     DateTime @default(now())
}

model Account {
  id               String   @id @default(uuid())

  accountName      String
  accountNumber    String?
  bankName         String?
  ifscCode         String?
  branch           String?

  type             AccountType

  openingBalance   Decimal @db.Decimal(15,2)
  currentBalance   Decimal @db.Decimal(15,2)

  isDefault        Boolean @default(false)
  isActive         Boolean @default(true)

  companyId        String
  company          Company @relation(fields: [companyId], references: [id])

  transactions     Transaction[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum AccountType {
  CASH
  BANK
  UPI
  WALLET
  CREDIT_CARD
  LOAN
}

model Party {
  id            String @id @default(uuid())

  name          String
  mobile        String?
  email         String?
  address       String?

  type          PartyType

  openingBalance Decimal @default(0)

  companyId     String
  company        Company @relation(fields: [companyId], references: [id])

  transactions  Transaction[]

  createdAt     DateTime @default(now())
}
enum PartyType {
  CUSTOMER
  VENDOR
  OTHER_CLIENT
}

model Transaction {

  id               String @id @default(uuid())

  voucherNo        String @unique

  type             String

  amount           Decimal @db.Decimal(15,2)

  description      String?

  transactionDate  DateTime

  accountHeadId    String
  accountHead      AccountHead @relation(fields:[accountHeadId], references:[id])

  partyId          String?
  party            Party? @relation(fields:[partyId], references:[id])

  accountId        String
  account          Account @relation(fields:[accountId], references:[id])

  companyId        String
  company          Company @relation(fields:[companyId], references:[id])

  sessionId        String
  session          Session @relation(fields:[sessionId], references:[id])

  createdBy        String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum HeadType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
}

model AccountHead {
  id            String    @id @default(uuid())

  name          String
  code          String?   @unique
  type          HeadType

  description   String?

  isActive      Boolean   @default(true)

  companyId     String
  company        Company   @relation(fields: [companyId], references: [id])

  transactions  Transaction[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}